# SBX Studio - Production Environment Variables Example
# Copy this file to .env.local for local development.
# For Vercel, configure these variables in: Project Settings -> Environment Variables.

# ----------------------------------------------------
# 1. SITE & APP CONFIGURATION
# ----------------------------------------------------
# Production canonical URL of your site (no trailing slash)
# Used for OpenGraph metadata and canonical links
NEXT_PUBLIC_SITE_URL=https://sbxstudio.com

# ----------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ----------------------------------------------------
# Connection string for hosted PostgreSQL (Neon, Supabase, Vercel Postgres, Railway)
# Must include connection pooling or sslmode=require for serverless
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/sbx_db?sslmode=require

# ----------------------------------------------------
# 3. ADMIN AUTHENTICATION & SECURITY
# ----------------------------------------------------
# Master password to access the /admin invoicing and management dashboard
# Change this to a strong passphrase in production
ADMIN_PASSWORD=your-super-strong-admin-password-here

# High-entropy secret key used to HMAC-SHA256 sign admin session cookies
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your-32-byte-hex-session-secret-here

# ----------------------------------------------------
# 4. EMAIL SERVICE (RESEND) - Contact & Quote Notifications
# ----------------------------------------------------
# API key from https://resend.com
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Destination email where new client inquiries are sent
CONTACT_TO_EMAIL=surjobanerjee207@gmail.com

# Verified sender email address configured in Resend (e.g. surjobanerjee207@gmail.com or custom domain)
# Defaults to onboarding@resend.dev during testing
CONTACT_FROM_EMAIL=surjobanerjee207@gmail.com
